# Copy this file to .env and change the values. .env is gitignored.

# Database (used by Docker Compose and the API)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rescate
DB_USER=root
DB_PASSWORD=change_me_dev_only

# API server
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Email (defaults point to Mailpit in Docker, production will use real mail service)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Rescate de San Carlos <no-reply@localhost>
APP_URL=http://localhost:5173
